  "rules": [
    {
      "id": "no-self-approval",
      "description": "A role cannot write and approve the same surface; the verifier is a separate mechanism."
    },
    {
      "id": "read-only-no-write",
      "description": "A role with no declared write surface cannot hold Write or Edit."
    }
