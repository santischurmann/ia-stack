# Distribution artifacts (build locally, don't commit)
*.zip
*.sha256
checksums.txt
dist/

# OS
.DS_Store
Thumbs.db

# Project memory is versioned: it is the evidence that VCP ran on itself.
# The installed runtime is not — it is a copy of this very repo and would duplicate it.
.vibe/vcp-runtime/

# Editor
.vscode/
.idea/

# Local pre-rewrite safety snapshots (not part of the product)
_backups/

# Tool caches / generated indexes (not product source)
.ua/
graphify-out/
research/.fetch/

# Derived full-corpus indexes are local evidence, not release source. They can be regenerated from
# the pinned external corpus and are intentionally kept out of the security release surface.
research/corpus-manifest-2026-08-31.json
research/semantic-ledger-2026-08-31.json
research/functional-inventory-2026-08-31.json
research/complete-review-index-2026-08-31.json
